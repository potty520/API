# ============================================================
#  systemd EnvironmentFile 模板
#  部署: sudo cp json-ingestion.env.example /opt/json-ingestion-system/config/json-ingestion.env
#        sudo chown ingestion:ingestion /opt/json-ingestion-system/config/json-ingestion.env
#        sudo chmod 600 /opt/json-ingestion-system/config/json-ingestion.env
#  说明: 这里的值是字面量, systemd 不做 ${VAR} 展开; 不要在此文件里引用别的变量
# ============================================================

# ---- 元数据库(存任务/日志/审计) ----
META_DB_URL=jdbc:mysql://127.0.0.1:3306/json_ingestion?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
META_DB_USER=json_ingestion
META_DB_PASSWORD=

# ---- 首次启动播种的目标库(应用会在这里自动建表) ----
TARGET_DB_HOST=127.0.0.1
TARGET_DB_PORT=3306
TARGET_DB_NAME=json_ingestion_target
TARGET_DB_USER=json_ingestion
TARGET_DB_PASSWORD=

# ---- AES 主密钥文件(首次启动自动生成, 必须纳入备份) ----
INGESTION_SECRET_FILE=/opt/json-ingestion-system/data/.secret

# ---- SSRF 防护开关: 接口全公网设 false(更安全); 有内网业务接口设 true ----
INGESTION_ALLOW_PRIVATE_URLS=true

# ---- 监听端口与地址: 有 Nginx 反代时保持 127.0.0.1 ----
INGESTION_PORT=3100
SERVER_ADDRESS=127.0.0.1

# ---- 首次启动的初始账号密码 ----
# 留空则生成一次性随机密码, 只在启动日志中输出一次; 所有初始账号首次登录都强制改密
INGESTION_INIT_ADMIN_PASSWORD=
INGESTION_INIT_CONFIG_PASSWORD=
INGESTION_INIT_RUNNER_PASSWORD=
INGESTION_INIT_VIEWER_PASSWORD=

# ---- 是否播种演示任务(生产建议 false) ----
INGESTION_SEED_DEMO=false

# ---- 内置免鉴权演示接口 /demo-api(生产建议 false) ----
INGESTION_DEMO_API=false

# ---- 反向代理信任开关 ----
# 应用只监听回环、由本机 Nginx 反代时保持 true(审计才能记录真实来源 IP);
# 应用直接对外时必须设 false, 否则客户端可伪造 X-Forwarded-For 绕过登录锁定
INGESTION_TRUST_PROXY=true

# ---- 接口动态参数 {{env.XXX}} 的可用前缀 ----
# 只有以该前缀命名的环境变量才允许被任务引用, 防止把 META_DB_PASSWORD 等敏感变量拼进外发请求
# 需要给任务传自定义变量时: 先定义 INGESTION_VAR_APPKEY=xxx, 再在任务里写 {{env.INGESTION_VAR_APPKEY}}
INGESTION_ENV_VAR_PREFIX=INGESTION_VAR_

# ---- 单个接口响应体读取上限(字节), 默认 32MB; 超限直接判失败, 防止内存被打满 ----
INGESTION_MAX_RESPONSE_BYTES=33554432
